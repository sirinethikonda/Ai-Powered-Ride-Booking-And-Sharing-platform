# Application Environment
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=rideapp_db
POSTGRES_USER=rideapp_user
POSTGRES_PASSWORD=rideapp_pass
POSTGRES_PORT=5432

# Redis Cache & Geospatial
REDIS_HOST=localhost
REDIS_PORT=6379

# Apache Kafka (KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET=VerySecretJwtKeyForSigningTokensMustBeAtLeast256BitsLongRideBookingPlatform2026
JWT_EXPIRATION_MS=86400000
